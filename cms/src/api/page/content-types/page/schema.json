{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Página",
    "description": "Página de conteúdo com Dynamic Zone de blocos."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "blocos": {
      "type": "dynamiczone",
      "components": [
        "blocos.hero",
        "blocos.busca",
        "blocos.grade-de-categorias",
        "blocos.produtos-em-destaque",
        "blocos.destaque-led",
        "blocos.como-funciona",
        "blocos.diferenciais",
        "blocos.avaliacoes",
        "blocos.chamada-final",
        "blocos.texto-rico",
        "blocos.faq",
        "blocos.formulario-contato",
        "blocos.comparativo-led"
      ],
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
